# Clé API Anthropic : active l'assistant IA et les explications d'articles.
# Sans clé, l'application fonctionne en mode hors ligne (réponses issues de la base de connaissances).
ANTHROPIC_API_KEY=

# Optionnel : désactiver la recherche web de l'assistant (true par défaut).
# ASSISTANT_WEB_SEARCH=false

# Optionnel : URL publique du site (plan du site, robots.txt).
# NEXT_PUBLIC_SITE_URL=https://prisme.example.com

# Optionnel : clé « demo » CoinGecko si l'API publique limite les requêtes.
# COINGECKO_API_KEY=
